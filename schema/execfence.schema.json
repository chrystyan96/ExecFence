{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/chrystyan96/execfence/master/schema/execfence.schema.json",
  "title": "execfence configuration",
  "description": "Project-level policy for execfence scans, reports, baseline exceptions, and stack-aware guardrail behavior.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "policyPack": {
      "description": "Stack-aware default policy to apply before explicit config overrides.",
      "type": "string",
      "minLength": 1,
      "default": "baseline"
    },
    "mode": {
      "description": "Whether blocking findings fail the command or are reported only.",
      "enum": ["block", "audit"],
      "default": "block"
    },
    "blockSeverities": {
      "description": "Finding severities that fail in block mode.",
      "type": "array",
      "items": { "enum": ["critical", "high", "medium", "low"] },
      "uniqueItems": true,
      "default": ["critical", "high"]
    },
    "warnSeverities": {
      "description": "Finding severities reported as warnings when not blocked.",
      "type": "array",
      "items": { "enum": ["critical", "high", "medium", "low"] },
      "uniqueItems": true,
      "default": ["medium", "low"]
    },
    "roots": {
      "description": "Legacy scan-scope hint. Repository config cannot narrow the default full-project scan; pass explicit CLI paths for a reviewed partial scan.",
      "type": "array",
      "items": { "type": "string" }
    },
    "ignoreDirs": {
      "description": "Legacy scan-scope hint. Repository config cannot add security-scan exclusions.",
      "type": "array",
      "items": { "type": "string" }
    },
    "skipFiles": {
      "description": "Legacy scan-scope hint. Repository config cannot add security-scan exclusions.",
      "type": "array",
      "items": { "type": "string" }
    },
    "allowExecutables": {
      "description": "Reviewed executable artifacts allowed in source/build-input folders. Entries must be SHA-256 pinned.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "reason"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "reason": { "type": "string", "minLength": 1 }
          }
      }
    },
    "extraSignatures": {
      "description": "Literal project-specific indicators to search for.",
      "type": "array",
      "items": { "type": "string" }
    },
    "extraRegexSignatures": {
      "description": "JavaScript regular expression source strings for project-specific detections.",
      "type": "array",
      "items": { "type": "string" }
    },
    "signaturesFile": {
      "description": "Path to a project/team external signatures JSON file.",
      "type": "string",
      "default": ".execfence/config/signatures.json"
    },
    "baselineFile": {
      "description": "Path to a reviewed baseline/exceptions JSON file.",
      "type": "string",
      "default": ".execfence/config/baseline.json"
    },
    "sandboxFile": {
      "description": "Path to the sandbox policy JSON file used by execfence run --sandbox and sandbox commands.",
      "type": "string",
      "default": ".execfence/config/sandbox.json"
    },
    "reportsDir": {
      "description": "Directory for automatic JSON evidence reports.",
      "type": "string",
      "default": ".execfence/reports"
    },
    "reportsGitignore": {
      "description": "When true, ExecFence keeps the reports directory ignored by git.",
      "type": "boolean",
      "default": true
    },
    "runtimeTrace": {
      "description": "Runtime gate trace settings for execfence run.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "postRunScan": { "type": "boolean", "default": true },
        "captureGitStatus": { "type": "boolean", "default": true },
        "redactEnv": { "type": "boolean", "default": true },
        "snapshotFiles": { "type": "boolean", "default": true },
        "recordArtifacts": { "type": "boolean", "default": false },
        "denyOnNewExecutable": { "type": "boolean", "default": false },
        "timeoutMs": { "type": "integer", "minimum": 100 }
      }
    },
    "analysis": {
      "description": "Analysis and optional enrichment settings for report generation.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "webEnrichment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "automaticForSeverities": {
              "type": "array",
              "items": { "enum": ["critical", "high", "medium", "low"] },
              "uniqueItems": true,
              "default": ["critical", "high"]
            },
            "maxQueriesPerFinding": { "type": "integer", "minimum": 0, "default": 3 },
            "allowedDomains": {
              "type": "array",
              "items": { "type": "string" },
              "default": []
            },
            "timeoutMs": { "type": "integer", "minimum": 100, "default": 4000 },
            "cacheTtlMs": { "type": "integer", "minimum": 0, "default": 86400000 }
          }
        }
      }
    },
    "manifest": {
      "description": "Execution manifest and coverage policy settings.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "default": ".execfence/manifest.json" },
        "requireRunWrapper": { "type": "boolean", "default": true },
        "blockNewEntrypoints": { "type": "boolean", "default": true },
        "sensitiveEntrypoints": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["build", "test", "dev", "start", "serve", "watch", "prepare", "install", "postinstall"]
        }
      }
    },
    "ci": {
      "description": "Single-command CI policy for scan, manifest, deps, package, trust, and reporting checks.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "baseRef": { "type": "string", "default": "HEAD" },
        "checks": {
          "type": "array",
          "items": { "enum": ["scan", "manifest-diff", "deps-diff", "coverage", "config-validate", "pack-audit", "trust-audit", "policy-diff", "approval-audit"] },
          "uniqueItems": true,
          "default": ["scan", "manifest-diff", "deps-diff", "coverage", "config-validate", "pack-audit", "trust-audit", "policy-diff"]
        }
      }
    },
    "wire": {
      "description": "Settings for execfence wire wrappers.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packageScripts": { "type": "boolean", "default": true },
        "workflows": { "type": "boolean", "default": true },
        "makefile": { "type": "boolean", "default": true },
        "vscodeTasks": { "type": "boolean", "default": true }
      }
    },
    "deps": {
      "description": "Deep dependency diff checks for lockfiles and package sources.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "detectRegistryDrift": { "type": "boolean", "default": true },
        "detectSuspiciousSources": { "type": "boolean", "default": true },
        "detectLifecycleEntries": { "type": "boolean", "default": true },
        "detectBinEntries": { "type": "boolean", "default": true },
        "detectTyposquatting": { "type": "boolean", "default": true }
      }
    },
    "supplyChain": {
      "description": "Guarded supply-chain metadata and dependency review settings.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["audit", "guarded", "strict"], "default": "guarded" },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 16, "default": 4 },
        "operationTimeoutMs": { "type": "integer", "minimum": 100, "default": 120000 },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "mode": { "enum": ["guarded", "audit", "off"], "default": "guarded" },
            "allowedRegistries": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["registry.npmjs.org", "pypi.org", "files.pythonhosted.org", "crates.io", "static.crates.io", "proxy.golang.org", "repo.maven.apache.org", "search.maven.org", "plugins.gradle.org", "api.nuget.org", "repo.packagist.org", "rubygems.org", "api.github.com", "codeload.github.com"]
            },
            "allowedPublicScopes": {
              "type": "array",
              "items": { "type": "string", "pattern": "^@[^/]+$" },
              "default": []
            },
            "releaseCooldownHours": { "type": "integer", "minimum": 0, "default": 48 },
            "maxPackagesPerRun": { "type": "integer", "minimum": 0, "default": 20 },
            "timeoutMs": { "type": "integer", "minimum": 100, "default": 2500 },
            "cacheTtlMs": { "type": "integer", "minimum": 0, "default": 86400000 },
            "networkFailure": { "enum": ["warn", "block"], "default": "warn" },
            "privateScopePolicy": { "enum": ["skip", "allow"], "default": "skip" },
            "packageAgeMinimumDays": { "type": "integer", "minimum": 0, "default": 7 },
            "packageModifiedCooldownHours": { "type": "integer", "minimum": 0, "default": 24 },
            "provenancePolicy": { "enum": ["off", "warn", "block"], "default": "warn" },
            "requireIntegrity": { "type": "boolean", "default": true },
            "tarballReview": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean", "default": true },
                "maxBytes": { "type": "integer", "minimum": 1024, "default": 5242880 },
                "networkFailure": { "enum": ["warn", "block"], "default": "warn" }
              }
            }
          }
        },
        "reputation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "sources": {
              "type": "array",
              "items": { "enum": ["npm", "osv", "github-advisory"] },
              "default": ["npm", "osv", "github-advisory"]
            },
            "cacheTtlMs": { "type": "integer", "minimum": 0, "default": 86400000 },
            "timeoutMs": { "type": "integer", "minimum": 100, "default": 2500 },
            "networkFailure": { "enum": ["warn", "block"], "default": "warn" },
            "maxPackagesPerRun": { "type": "integer", "minimum": 0, "default": 20 }
          }
        }
      }
    },
    "adopt": {
      "description": "Low-noise first-run adoption settings.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "writeSuggestedBaseline": { "type": "boolean", "default": false },
        "blockDuringAdoption": { "type": "boolean", "default": false }
      }
    },
    "policy": {
      "description": "Organization/local policy controls.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "customPoliciesDir": { "type": "string", "default": ".execfence/config/policies" },
        "requiredOwners": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          },
          "default": {}
        }
      }
    },
    "performance": {
      "description": "Bounded cache and worker controls. Cache entries are keyed by full content hash, policy fingerprint, and tool version.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scanCache": { "type": "boolean", "default": true },
        "scanCacheMaxEntries": { "type": "integer", "minimum": 100, "maximum": 100000, "default": 10000 },
        "dependencyConcurrency": { "type": "integer", "minimum": 1, "maximum": 16, "default": 4 },
        "maxWorkerMemoryMb": { "type": "integer", "minimum": 64, "maximum": 2048, "default": 256 }
      }
    },
    "approvals": {
      "description": "Granular, expiring and cryptographically verifiable approval policy.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "default": ".execfence/approvals.json" },
        "approversPath": { "type": "string", "default": ".execfence/trust/approvers.json" },
        "requireSignedFindings": { "type": "boolean", "default": true },
        "requireSignedManifest": { "type": "boolean", "default": false },
        "requireSignedPolicyChanges": { "type": "boolean", "default": false },
        "minimumSignatures": { "type": "integer", "minimum": 1, "maximum": 20, "default": 1 }
      }
    },
    "trustStore": {
      "description": "Paths for reviewed trust stores.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": { "type": "string", "default": ".execfence/trust/files.json" },
        "actions": { "type": "string", "default": ".execfence/trust/actions.json" },
        "registries": { "type": "string", "default": ".execfence/trust/registries.json" },
        "packageScopes": { "type": "string", "default": ".execfence/trust/package-scopes.json" },
        "packageSources": { "type": "string", "default": ".execfence/trust/package-sources.json" }
      }
    },
    "htmlReport": {
      "description": "Local HTML report rendering options.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "includeRuntimeTrace": { "type": "boolean", "default": true },
        "includeManifest": { "type": "boolean", "default": true }
      }
    },
    "reportRetention": {
      "description": "Deprecated compatibility alias for reports.retention.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxReports": { "type": "integer", "minimum": 1, "default": 100 },
        "maxAgeDays": { "type": "integer", "minimum": 1, "default": 90 }
      }
    },
    "reports": {
      "description": "Report UX and retention settings.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxReports": { "type": "integer", "minimum": 1, "default": 100 },
            "maxAgeDays": { "type": "integer", "minimum": 1, "default": 90 }
          }
        }
      }
    },
    "redaction": {
      "description": "Local redaction policy for evidence and external enrichment queries.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "redactLocalPaths": { "type": "boolean", "default": true },
        "redactEnv": { "type": "boolean", "default": true },
        "extraPatterns": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "workflowHardening": {
      "description": "Enable GitHub Actions hardening checks.",
      "type": "boolean",
      "default": true
    },
    "archiveAudit": {
      "description": "Report committed archives such as .zip, .tar, .tgz, and .asar in source/build-input folders.",
      "type": "boolean",
      "default": true
    },
    "auditAllPackageScripts": {
      "description": "Audit all package.json scripts instead of only install/prepare lifecycle scripts.",
      "type": "boolean",
      "default": false
    }
  }
}
