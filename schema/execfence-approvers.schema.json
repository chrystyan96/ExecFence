{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/chrystyan96/execfence/master/schema/execfence-approvers.schema.json",
  "title": "ExecFence trusted approval signing keys",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "approvers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "approvers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyId", "owner", "reason", "expiresAt", "algorithm", "fingerprint", "publicKeyPem", "addedAt"],
        "properties": {
          "keyId": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "expiresAt": { "type": "string", "format": "date-time" },
          "algorithm": { "enum": ["ed25519", "ed448", "rsa", "rsa-pss", "ec"] },
          "fingerprint": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$" },
          "publicKeyPem": { "type": "string", "minLength": 32 },
          "addedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
